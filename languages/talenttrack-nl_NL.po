#, php-format
msgid ""
"The duration was shortened to %d minutes, the safe maximum for this age "
"group."
msgstr ""
"De duur is ingekort tot %d minuten, het veilige maximum voor deze "
"leeftijdsgroep."

#: src/Modules/Vct/Rules/RuleMessages.php:91
msgid "The duration was shortened to the safe maximum for this age group."
msgstr "De duur is ingekort tot het veilige maximum voor deze leeftijdsgroep."

#: src/Modules/Vct/Rules/RuleMessages.php:94
msgid ""
"No season periodisation block applies here, so a neutral training load was "
"used."
msgstr ""
"Hier is geen seizoensperiodiseringsblok van toepassing, dus is een neutrale "
"trainingsbelasting gebruikt."

#. translators: %d is the percentage the load was reduced by
#: src/Modules/Vct/Rules/RuleMessages.php:101
#, php-format
msgid ""
"The load was eased by %d%% because some players are flagged for a growth "
"spurt (PHV)."
msgstr ""
"De belasting is met %d%% verlaagd omdat sommige spelers gemarkeerd zijn voor "
"een groeispurt (PHV)."

#: src/Modules/Vct/Rules/RuleMessages.php:105
