#: src/Shared/Frontend/FrontendConfigurationView.php:525
#: src/Shared/Frontend/FrontendConfigurationView.php:780
msgid ""
"Lowercase ASCII, no spaces. Used as the database identifier and cannot be "
"changed later."
msgstr ""
"Kleine letters (ASCII), geen spaties. Wordt gebruikt als database-identifier "
"en kan later niet meer worden gewijzigd."

#: src/Shared/Frontend/FrontendConfigurationView.php:526
#: src/Shared/Frontend/FrontendConfigurationView.php:778
msgid ""
"Stable database identifier. Locked once the row is created — change it via a "
"code migration."
msgstr ""
"Stabiele database-identifier. Vastgezet zodra de regel is aangemaakt — "
"wijzig via een code-migratie."

#: src/Shared/Frontend/FrontendConfigurationView.php:559
