msgstr "Interne sleutel"

#: src/Shared/Frontend/FrontendConfigurationView.php:800
#: src/Shared/Frontend/FrontendConfigurationView.php:1032
msgid "Pill colour"
msgstr "Pill-kleur"

#: src/Shared/Frontend/FrontendConfigurationView.php:807
msgid "Used wherever this value renders as a colour-coded pill."
msgstr ""
"Wordt overal gebruikt waar deze waarde als gekleurd label wordt weergegeven."

#: src/Shared/Frontend/FrontendConfigurationView.php:814
msgid "Description (canonical, optional)"
msgstr "Beschrijving (canoniek, optioneel)"

#. translators: %d = number of supported locales
