msgstr "Je voorbereiding is klaar"

#. translators: 1: items scored, 2: items on the form
#: src/Modules/Pdp/Frontend/PdpPreparationView.php
msgid "%1$d of %2$d item scored"
msgid_plural "%1$d of %2$d items scored"
msgstr[0] "%1$d van %2$d onderdeel ingevuld"
msgstr[1] "%1$d van %2$d onderdelen ingevuld"

#. translators: %s: date and time of the talk
#: src/Modules/Pdp/Frontend/PdpPreparationView.php
