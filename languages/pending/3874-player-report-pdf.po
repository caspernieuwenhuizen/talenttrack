#: src/Modules/Analytics/Frontend/PlayerReportPage.php
msgctxt "player report panel"
msgid "Printed copy"
msgstr "Afdruk"

#: src/Modules/Analytics/Frontend/PlayerReportPage.php
msgid "The layout shapes the printed copy. On screen, every selected section is shown in full."
msgstr "De indeling bepaalt de afdruk. Op het scherm zie je elk gekozen onderdeel volledig."

#: src/Modules/Analytics/Frontend/PlayerReportPage.php
msgid "Does not fit on one page, even with long lists shortened. Drop a section, or switch to the two-page pack."
msgstr "Past niet op één pagina, ook niet met ingekorte lijsten. Laat een onderdeel weg, of kies het pakket van twee pagina's."

#: src/Modules/Analytics/Frontend/PlayerReportPage.php
msgid "Runs past two pages. Drop a section or pick a shorter period."
msgstr "Loopt over twee pagina's heen. Laat een onderdeel weg of kies een kortere periode."

#: src/Modules/Analytics/Frontend/PlayerReportPage.php
msgid "Fits by shortening: long lists keep their most recent entries and say how many more there are, the development plan becomes one line, and the notes area keeps three lines."
msgstr "Past door in te korten: lange lijsten houden hun meest recente items en zeggen hoeveel er nog meer zijn, het ontwikkelplan wordt één regel en het notitievak houdt drie lijntjes."

#: src/Modules/Analytics/Reports/PlayerReportLayout.php
msgid "A4, one page. What you bring to a conversation; long lists keep their most recent entries."
msgstr "A4, één pagina. Wat je meeneemt naar een gesprek; lange lijsten houden hun meest recente items."

#: src/Modules/Analytics/Reports/PlayerReportLayout.php
msgid "Two-page pack"
msgstr "Pakket van twee pagina's"

#: src/Modules/Analytics/Reports/PlayerReportLayout.php
msgid "A4, up to two pages. Room for every evaluation, match and test in the period."
msgstr "A4, maximaal twee pagina's. Ruimte voor elke evaluatie, wedstrijd en test in de periode."

