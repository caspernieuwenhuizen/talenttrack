#: src/Modules/Pdp/Frontend/FrontendPdpManageView.php
#: src/Modules/Pdp/Frontend/FrontendMyPdpView.php
#: src/Modules/Pdp/Frontend/FrontendPdpPlanningView.php
msgctxt "PDP talk status: the talk did not take place"
msgid "Not held"
msgstr "Niet doorgegaan"

#: src/Modules/Pdp/Frontend/FrontendPdpManageView.php
#. translators: %s: the date the talk was marked as not held
msgid "Marked on %s."
msgstr "Gemarkeerd op %s."

#: src/Modules/Pdp/Frontend/FrontendPdpManageView.php
msgid "This talk did not take place…"
msgstr "Dit gesprek is niet doorgegaan…"

#: src/Modules/Pdp/Frontend/FrontendPdpManageView.php
msgid "Mark this talk as not held? The next talk in the cycle becomes the current one."
msgstr "Dit gesprek markeren als niet doorgegaan? Het volgende gesprek in de cyclus wordt dan het huidige."

#: src/Modules/Pdp/Frontend/FrontendPdpManageView.php
msgid "Why did the talk not take place?"
msgstr "Waarom is het gesprek niet doorgegaan?"

#: src/Modules/Pdp/Frontend/FrontendPdpManageView.php
msgid "The talk stays on the file as not held, with this reason. The player and their parents see it too."
msgstr "Het gesprek blijft als niet doorgegaan in het dossier staan, met deze reden. De speler en de ouders zien dat ook."

#: src/Modules/Pdp/Frontend/FrontendPdpManageView.php
msgid "Mark as not held"
msgstr "Markeren als niet doorgegaan"

#: src/Modules/Pdp/Frontend/FrontendPdpManageView.php
msgid "Take the not-held mark off? This talk becomes the current one again."
msgstr "De markering niet doorgegaan weghalen? Dit gesprek wordt dan weer het huidige."

#: src/Modules/Pdp/Frontend/FrontendPdpManageView.php
msgid "Undo not held"
msgstr "Niet doorgegaan ongedaan maken"

#: src/Modules/Pdp/Frontend/FrontendPdpManageView.php
msgid "The verdict opens once every conversation in the cycle is signed off or marked as not held."
msgstr "Het eindoordeel komt vrij zodra elk gesprek in de cyclus is ondertekend of als niet doorgegaan is gemarkeerd."

#: src/Modules/Pdp/Frontend/FrontendPdpPlanningView.php
#. translators: %d: number of PDP talks that did not take place
msgid "%d not held"
msgid_plural "%d not held"
msgstr[0] "%d niet doorgegaan"
msgstr[1] "%d niet doorgegaan"

#: src/Modules/Pdp/Frontend/FrontendPdpPlanningView.php
msgid "The coach marked the talk as not having taken place, with a reason. The cycle has moved on to the next talk."
msgstr "De coach heeft het gesprek gemarkeerd als niet doorgegaan, met een reden. De cyclus is doorgegaan naar het volgende gesprek."

#: src/Modules/Pdp/Rest/PdpConversationsRestController.php
msgid "Only the coach of this PDP file or the head of development can mark a talk as not held."
msgstr "Alleen de coach van dit POP-dossier of het hoofd opleiding kan een gesprek als niet doorgegaan markeren."

#: src/Modules/Pdp/Rest/PdpConversationsRestController.php
msgid "Mark a talk as not held on its own, without other changes in the same request."
msgstr "Markeer een gesprek als niet doorgegaan zonder andere wijzigingen in hetzelfde verzoek."

#: src/Modules/Pdp/Rest/PdpConversationsRestController.php
msgid "A later talk has already moved on, so this talk stays marked as not held."
msgstr "Een later gesprek is al verder, dus dit gesprek blijft gemarkeerd als niet doorgegaan."

#: src/Modules/Pdp/Rest/PdpConversationsRestController.php
msgid "This talk took place or has been signed, so it cannot be marked as not held."
msgstr "Dit gesprek heeft plaatsgevonden of is ondertekend, dus het kan niet als niet doorgegaan worden gemarkeerd."

#: src/Modules/Pdp/Rest/PdpConversationsRestController.php
msgid "Only the current talk can be marked as not held. Earlier talks come first."
msgstr "Alleen het huidige gesprek kan als niet doorgegaan worden gemarkeerd. Eerdere gesprekken gaan voor."

#: src/Modules/Pdp/Rest/PdpConversationsRestController.php
msgid "Say why the talk did not take place."
msgstr "Geef aan waarom het gesprek niet is doorgegaan."

#: src/Modules/Pdp/Rest/PdpConversationsRestController.php
#. translators: %d: the maximum number of characters
msgid "Keep the reason to %d characters."
msgstr "Houd de reden op maximaal %d tekens."

#: src/Modules/Pdp/Rest/PdpConversationsRestController.php
msgid "This talk did not take place, so it takes no reflection. Write it for the next talk instead."
msgstr "Dit gesprek is niet doorgegaan, dus er hoort geen reflectie bij. Schrijf die voor het volgende gesprek."
