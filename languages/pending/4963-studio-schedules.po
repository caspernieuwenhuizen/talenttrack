msgstr "De pdf kon deze keer niet worden gemaakt. Het schema probeert het bij de volgende verzending opnieuw."

#: src/Modules/ReportStudio/Domain/StudioScheduleDelivery.php
#, php-format
msgid "Left out so every recipient may read the PDF: %s."
msgstr "Weggelaten zodat elke ontvanger de pdf mag lezen: %s."

