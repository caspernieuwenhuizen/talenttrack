#: src/Modules/Analytics/Frontend/FrontendScheduledReportsView.php
#, php-format
msgid "Report Studio · %s"
msgstr "Report Studio · %s"

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
#: src/Modules/ReportStudio/Frontend/ReportScheduleScreen.php
msgid "Scheduled reports are not part of your plan."
msgstr "Ingeplande rapporten horen niet bij je abonnement."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
msgid "This report is kept for its owner alone, so only they can receive it on a schedule."
msgstr "Dit rapport is alleen voor de eigenaar bewaard, dus alleen de eigenaar kan het volgens schema ontvangen."

#: src/Modules/ReportStudio/Domain/StudioScheduleDelivery.php
msgid "Stopped: the person who set up this schedule may no longer send reports to others."
msgstr "Gestopt: wie dit schema instelde, mag geen rapporten meer naar anderen sturen."

#: src/Modules/ReportStudio/Domain/StudioScheduleDelivery.php
msgid "Not sent: no block of this report is one every recipient may read."
msgstr "Niet verstuurd: geen blok van dit rapport is er een dat elke ontvanger mag lezen."

#: src/Modules/ReportStudio/Frontend/ReportScheduleScreen.php
msgid "The name is too long."
msgstr "De naam is te lang."

#: src/Modules/ReportStudio/Frontend/ReportScheduleScreen.php
msgid "This report cannot be sent on a schedule."
msgstr "Dit rapport kan niet volgens schema worden verstuurd."

#: src/Modules/Comms/Template/TemplateGuide.php
msgid "Tells the person who set up a scheduled Report Studio report that it was paused instead of sent, says why, and links to the schedule."
msgstr "Laat wie een Report Studio-rapport inplande weten dat het gepauzeerd is in plaats van verstuurd, zegt waarom en linkt naar het schema."

#: src/Modules/Comms/Template/TemplateGuide.php
msgid "The first time a run finds the report archived or unpublished, its subject gone, or its owner no longer allowed to change it. It is sent again only if the schedule breaks again after it has been resumed."
msgstr "De eerste keer dat een verzending het rapport gearchiveerd of niet meer gepubliceerd vindt, het onderwerp verdwenen, of de eigenaar die het niet meer mag wijzigen. Het wordt alleen opnieuw verstuurd als het schema na hervatten weer vastloopt."

#: src/Modules/Comms/Templates/ScheduledReportPausedTemplate.php
msgid "Scheduled report paused"
msgstr "Ingepland rapport gepauzeerd"

#: src/Modules/Comms/Templates/ScheduledReportPausedTemplate.php
msgid "Your scheduled report is paused"
msgstr "Je ingeplande rapport is gepauzeerd"

#: src/Modules/Comms/Templates/ScheduledReportPausedTemplate.php
msgid ""
"Your scheduled report \"{schedule_name}\" was not sent and is paused: {reason} Nothing is sent until someone who may change the report resumes it.\n"
"\n"
"Open the schedule: {schedule_url}"
msgstr ""
"Je ingeplande rapport \"{schedule_name}\" is niet verstuurd en gepauzeerd: {reason} Er wordt niets verstuurd tot iemand die het rapport mag wijzigen het hervat.\n"
"\n"
"Open het schema: {schedule_url}"

#: src/Modules/ReportStudio/Domain/BlockEngine.php
msgid "Not every recipient may read this block."
msgstr "Niet elke ontvanger mag dit blok lezen."

#: src/Modules/ReportStudio/Domain/BlockEngine.php
msgid "Its figures differ between recipients, so it is left out."
msgstr "De cijfers verschillen per ontvanger, dus het blok valt weg."

#: src/Modules/ReportStudio/Domain/ReportData.php
msgid "No player in this group is one every recipient may see."
msgstr "Geen speler in deze groep is er een die elke ontvanger mag zien."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
msgid "A scheduled mail is for staff. A report for a family or a scout is shared through a snapshot."
msgstr "Een ingeplande mail is voor staf. Een rapport voor een gezin of een scout wordt gedeeld via een momentopname."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
msgid "A scheduled mail is one copy for everyone, so it cannot follow whoever opens it."
msgstr "Een ingeplande mail is één exemplaar voor iedereen, dus die kan niet meegaan met wie hem opent."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
msgid "A scheduled mail needs a report that always shows the same player or team."
msgstr "Een ingeplande mail vraagt een rapport dat altijd dezelfde speler of hetzelfde team toont."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
msgid "This report is archived."
msgstr "Dit rapport is gearchiveerd."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
msgid "Publish the report before you schedule it: a schedule sends the published version."
msgstr "Publiceer het rapport voordat je het inplant: een schema verstuurt de gepubliceerde versie."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
#, php-format
msgid "A name is at most %d characters."
msgstr "Een naam is hooguit %d tekens."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
msgid "Choose weekly, monthly or at the end of the season."
msgstr "Kies wekelijks, maandelijks of aan het eind van het seizoen."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
msgid "A schedule is active or paused."
msgstr "Een schema is actief of gepauzeerd."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
msgid "Choose who receives the report."
msgstr "Kies wie het rapport ontvangt."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
msgid "A recipient is an account in this club or a staff role."
msgstr "Een ontvanger is een account in deze club of een stafrol."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
msgid "Recipients are accounts and staff roles only. Someone without an account needs one first."
msgstr "Ontvangers zijn alleen accounts en stafrollen. Wie geen account heeft, krijgt er eerst een."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
#, php-format
msgid "A schedule goes to at most %d recipients. Choose a role instead of many people."
msgstr "Een schema gaat naar hooguit %d ontvangers. Kies een rol in plaats van veel mensen."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
#: src/Modules/ReportStudio/Frontend/ReportScheduleScreen.php
msgid "You may schedule this report for yourself. Sending it to others needs the right to publish reports."
msgstr "Je mag dit rapport voor jezelf inplannen. Het naar anderen sturen vraagt het recht om rapporten te publiceren."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
msgid "Choose last week, last month, this month or this season."
msgstr "Kies vorige week, vorige maand, deze maand of dit seizoen."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
#, php-format
msgid "This schedule reaches more than %d people. Choose fewer recipients, or a smaller role."
msgstr "Dit schema bereikt meer dan %d mensen. Kies minder ontvangers, of een kleinere rol."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
#: src/Modules/ReportStudio/Frontend/ReportScheduleScreen.php
msgid "There is no such schedule."
msgstr "Dat schema bestaat niet."

#: src/Modules/ReportStudio/Domain/ReportSchedules.php
msgid "You may not change this schedule."
msgstr "Je mag dit schema niet wijzigen."

#: src/Modules/ReportStudio/Domain/StudioScheduleDelivery.php
msgid "Stopped: the report in this schedule no longer exists."
msgstr "Gestopt: het rapport in dit schema bestaat niet meer."

#: src/Modules/ReportStudio/Domain/StudioScheduleDelivery.php
#, php-format
msgid "Stopped: %s"
msgstr "Gestopt: %s"

#: src/Modules/ReportStudio/Domain/StudioScheduleDelivery.php
msgid "Stopped: the player or team this report is about no longer exists."
msgstr "Gestopt: de speler of het team waar dit rapport over gaat, bestaat niet meer."

#: src/Modules/ReportStudio/Domain/StudioScheduleDelivery.php
msgid "Stopped: the person who set up this schedule may no longer change this report."
msgstr "Gestopt: wie dit schema instelde, mag dit rapport niet meer wijzigen."

#: src/Modules/ReportStudio/Domain/StudioScheduleDelivery.php
#, php-format
msgid "Not sent: %s"
msgstr "Niet verstuurd: %s"

#: src/Modules/ReportStudio/Domain/StudioScheduleDelivery.php
