#: src/Modules/Analytics/Reports/TeamMonthlyReportLayout.php
msgid "Needs the pack (up to four pages). Landscape prints the summary."
msgstr "Hiervoor is het pakket nodig (tot vier pagina's). Het liggende overzicht drukt de samenvatting af."

#: src/Modules/Analytics/Reports/TeamMonthlyReportLayout.php
msgid "Needs the pack (up to four pages). The one-pager prints the summary."
msgstr "Hiervoor is het pakket nodig (tot vier pagina's). De versie van één pagina drukt de samenvatting af."

#: src/Modules/Export/Exporters/TeamMonthlyReportPdfDocument.php
msgid "+ %1$d more test, in the pack: %2$s"
msgid_plural "+ %1$d more tests, in the pack: %2$s"
msgstr[0] "+ nog %1$d test, in het pakket: %2$s"
msgstr[1] "+ nog %1$d testen, in het pakket: %2$s"

#: src/Modules/Analytics/Frontend/TeamMonthlyReportPage.php
msgid "This report asked for “%s”, which this layout cannot print. It prints the summary; choose the pack to print the tables."
msgstr "Dit rapport vroeg om “%s”, en dat kan deze soort niet afdrukken. De afdruk toont de samenvatting; kies het pakket om de tabellen af te drukken."

#: src/Modules/Analytics/Frontend/TeamMonthlyReportPage.php
msgid "Landscape prints up to %1$d tests; %2$d are selected. The PDF names the ones it leaves out."
msgstr "Het liggende overzicht drukt maximaal %1$d testen af; er zijn er %2$d gekozen. De pdf noemt de testen die zijn weggelaten."
