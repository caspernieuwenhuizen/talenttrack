includes:
    # phpstan-wordpress's extension. Without it PHPStan does not know a single
    # WordPress symbol — `Function get_option not found`, `invalid return type
    # WP_Error`, thousands of times — because there is no
    # phpstan/extension-installer in composer.json to register it
    # automatically, and `bootstrapFiles` alone does not (#2103). Drowning in
    # that noise is almost certainly why the gate ended up silenced and the
    # baseline blanket-ignoring a whole tree.
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    # Baseline file grandfathers existing issues so CI can be green from day one.
    # New code must pass clean; existing issues are cleaned up incrementally.
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - src
    # #2831 — the plugin bootstrap defines TT_PLUGIN_URL / TT_VERSION /
    # TT_PLUGIN_DIR, which nearly every enqueue in `src` reads. It is not in
    # `paths`, so PHPStan had never seen them: every existing use sits in the
    # baseline, and any NEW file that enqueues a stylesheet failed the gate
    # with "Constant TT_PLUGIN_URL not found". `scanFiles` collects the
    # symbols without analysing the file, which is exactly the fix.
    scanFiles:
        - talenttrack.php
    bootstrapFiles:
        - vendor/szepeviktor/phpstan-wordpress/bootstrap.php
    ignoreErrors: []
    # A baseline entry that no longer matches must not fail the build.
    #
    # Baseline messages embed the code they describe, down to literal argument
    # values — one of them contains `entity: 'holidays'`. Renaming that entity
    # in #2788 left the entry unmatched, and with the default
    # `reportUnmatchedIgnoredErrors: true` that alone turned CI red on a change
    # that introduced no error whatsoever.
    #
    # Left on, any PR that fixes or edits a baselined line fails for having
    # improved things. That makes the gate hostile, and a hostile gate gets
    # silenced — which is the `|| true` #2103 just removed. A stale entry is
    # harmless and disappears at the next `--generate-baseline`.
    reportUnmatchedIgnoredErrors: false
